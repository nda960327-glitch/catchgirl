// 캐치걸 — 지정 캐치걸 실시간 예약 시스템
// Vercel 배포용 Postgres 사용 중. DATABASE_URL 을 Postgres 연결 문자열로 설정하면 동일 스키마가 그대로 동작한다.
// (JSON 배열 컬럼은 SQLite 호환 흔적으로 String 에 JSON 문자열로 저장)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────── 매장 (멀티테넌트 루트) ─────────────────
model Store {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  tagline             String   @default("")
  logoUrl             String?
  coverUrl            String?
  themeColor          String   @default("#B4586A")
  openTime            String   @default("15:00") // HH:mm
  closeTime           String   @default("23:00") // HH:mm
  slotMinutes         Int      @default(30)
  closedDays          String   @default("[]")    // JSON: 정기 휴무 요일 [0(일)~6(토)]
  cancelDeadlineHours Int      @default(2)
  maxAdvanceDays      Int      @default(14)
  noshowPolicy        String   @default("노쇼 3회 누적 시 예약이 제한될 수 있어요.")
  createdAt           DateTime @default(now())

  staff         Staff[]
  customers     Customer[]
  reservations  Reservation[]
  admins        AdminUser[]
  reviews       Review[]
  comments      Comment[]
  customerNotes CustomerNote[]
}

model AdminUser {
  id           String @id @default(cuid())
  storeId      String
  email        String @unique
  passwordHash String
  name         String @default("관리자")
  store        Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ───────────────── 캐치걸(Staff) ─────────────────
model Staff {
  id              String   @id @default(cuid())
  storeId         String
  nickname        String
  bio             String   @default("")
  tags            String   @default("[]") // JSON string[]
  photos          String   @default("[]") // JSON string[] (url)
  isActive        Boolean  @default(true)
  capacityPerSlot Int      @default(1)
  sortOrder       Int      @default(0)
  loginId         String?  @unique // 관리자가 발급한 계정
  passwordHash    String?
  createdAt       DateTime @default(now())

  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  schedules    StaffSchedule[]
  offs         StaffOff[]
  reservations Reservation[]
  reviews      Review[]
  comments     Comment[]
  favorites    Favorite[]
  votes        StaffVote[]

  @@index([storeId, isActive])
}

model StaffSchedule {
  id        String @id @default(cuid())
  staffId   String
  weekday   Int // 0(일)~6(토)
  startTime String // HH:mm
  endTime   String // HH:mm
  staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
}

model StaffOff {
  id      String  @id @default(cuid())
  staffId String
  date    String // YYYY-MM-DD
  reason  String?
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
}

// ───────────────── 고객 ─────────────────
// 개인정보(휴대폰·실명·생일·이메일·SNS)는 수집하지 않는다.
// 신원은 매장 안에서만 통하는 닉네임 + PIN 이고, 사람에 대한 기억은 adminMemo / CustomerNote 에 남긴다.
model Customer {
  id            String   @id @default(cuid())
  storeId       String
  nickname      String
  passwordHash  String? // 고객이 정한 PIN. 관리자가 대신 만든 고객은 null → 첫 로그인 때 설정
  referral      String? // 방문 경로 (인스타/지인소개/검색/기타)
  adminMemo     String   @default("") // 상단 고정 메모 (한눈에 보는 핵심)
  isBlacklisted Boolean  @default(false)
  createdAt     DateTime @default(now())

  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  reviews      Review[]
  comments     Comment[]
  favorites    Favorite[]
  notes        CustomerNote[]
  votes        StaffVote[]

  @@unique([storeId, nickname])
}

/** 관리자가 방문마다 남기는 날짜별 메모 (adminMemo 는 고정 요약, 이쪽은 시간순 기록) */
model CustomerNote {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  authorName String
  content    String
  createdAt  DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

// ───────────────── 예약 ─────────────────
// 동시성: slotKey = `${staffId}|${startTime ISO}|${seq}` 에 UNIQUE.
// seq 는 0 ~ capacityPerSlot-1 (동시 접객 N팀). 취소 시 slotKey 를 null 로 비워 자리를 반납한다.
// capacity=1 이면 사실상 UNIQUE(store_id, staff_id, start_time) 와 동일하게 동작.
model Reservation {
  id          String    @id @default(cuid())
  code        String    @unique // 예약번호 (예: 2608-0231)
  storeId     String
  staffId     String
  customerId  String
  startTime   DateTime
  endTime     DateTime
  partySize   Int       @default(1)
  requestNote String    @default("")
  purposeTag  String    @default("")
  status      String    @default("CONFIRMED") // CONFIRMED | COMPLETED | CANCELLED | NOSHOW
  createdBy   String    @default("CUSTOMER") // CUSTOMER | ADMIN
  slotKey     String?   @unique
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  review   Review?

  @@index([storeId, startTime])
  @@index([staffId, startTime])
  @@index([customerId, startTime])
}

// ───────────────── 후기 / 댓글 / 찜 ─────────────────
model Review {
  id            String    @id @default(cuid())
  storeId       String
  reservationId String    @unique
  staffId       String
  customerId    String
  rating        Int
  content       String
  photos        String    @default("[]") // JSON string[]
  isHidden      Boolean   @default(false)
  isReported    Boolean   @default(false)
  reportReason  String?
  reply         String?
  repliedAt     DateTime?
  createdAt     DateTime  @default(now())

  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  staff       Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([staffId, isHidden])
}

model Comment {
  id         String   @id @default(cuid())
  storeId    String
  staffId    String
  customerId String?
  authorType String   @default("CUSTOMER") // CUSTOMER | STAFF | ADMIN
  authorName String
  content    String
  parentId   String?
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staff    Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")

  @@index([staffId, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  staffId    String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([customerId, staffId])
}

/** 캐치걸 추천/비추천 — 고객 1명당 캐치걸 1명에게 한 표. 같은 버튼을 다시 누르면 취소된다. */
model StaffVote {
  id         String   @id @default(cuid())
  customerId String
  staffId    String
  value      String // UP | DOWN
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([customerId, staffId])
  @@index([staffId, value])
}
