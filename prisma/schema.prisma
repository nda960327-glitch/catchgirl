// 캐치걸 — 지정 캐치걸 실시간 예약 시스템
// Vercel 배포용 Postgres 사용 중. DATABASE_URL 을 Postgres 연결 문자열로 설정하면 동일 스키마가 그대로 동작한다.
// (JSON 배열 컬럼은 SQLite 호환 흔적으로 String 에 JSON 문자열로 저장)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────── 매장 (멀티테넌트 루트) ─────────────────
model Store {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  tagline             String   @default("")
  // 고객 홈 상단 큰 문구. {n} 자리에 오늘 예약 가능한 캐치걸 수가 들어간다.
  heroTitle           String   @default("오늘 자리를 지키는\n{n} 사람")
  logoUrl             String?
  coverUrl            String?
  themeColor          String   @default("#B4586A")
  // 화면 한 벌 (로즈·크림·누아르·와인·미드나이트). 어두운 테마도 여기서 고른다.
  theme               String   @default("rose")
  // 구독 — 한도는 코드(plans.ts)에서 관리하고 여기엔 어느 요금제인지만 둔다
  plan                String   @default("PRO") // PRO | MAX
  planStartedAt       DateTime @default(now())
  openTime            String   @default("15:00") // HH:mm
  closeTime           String   @default("23:00") // HH:mm
  shiftSplitTime      String   @default("20:00") // 주간조/야간조가 갈리는 시각
  slotMinutes         Int      @default(30)
  closedDays          String   @default("[]")    // JSON: 정기 휴무 요일 [0(일)~6(토)]
  cancelDeadlineHours Int      @default(2)
  maxAdvanceDays      Int      @default(14)
  // 손님이 바로 물어볼 수 있는 창구. 앱에서 눌러 전화·텔레그램으로 이어진다.
  contactPhone        String   @default("")
  contactTelegram     String   @default("") // @ 없이 아이디만 저장한다
  noshowPolicy        String   @default("노쇼 3회 누적 시 예약이 제한될 수 있어요.")
  createdAt           DateTime @default(now())

  staff         Staff[]
  customers     Customer[]
  reservations  Reservation[]
  admins        AdminUser[]
  reviews       Review[]
  comments      Comment[]
  customerNotes CustomerNote[]
  options       StoreOption[]
  notices       Notice[]
  rooms         Room[]
  assignments   ShiftAssignment[]
  coupons       Coupon[]
  gradeBenefits GradeBenefit[]
  promotions    DayPromotion[]
  sources       ReferralSource[]
}

/**
 * 방문 경로. 신규 손님이 처음 어디서 알고 왔는지 — 사이트, 텔레그램 문의 등.
 * tier 는 그 사이트가 무료 등록인지 유료 메이저인지 표시해, 돈 쓴 곳이 실제로
 * 손님을 데려오는지 한눈에 비교하려는 것이다.
 */
model ReferralSource {
  id        String  @id @default(cuid())
  storeId   String
  name      String
  tier      String  @default("") // FREE | MAJOR | ""
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([storeId, name])
}

model AdminUser {
  id           String @id @default(cuid())
  storeId      String
  email        String @unique
  passwordHash String
  name         String @default("관리자")
  // 새 예약 알림 기준 — 이 시각 이후에 들어온 예약이 "새 예약" 이다
  lastSeenReservationAt DateTime?
  store        Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ───────────────── 캐치걸(Staff) ─────────────────
model Staff {
  id              String   @id @default(cuid())
  storeId         String
  nickname        String
  bio             String   @default("")
  tags            String   @default("[]") // JSON string[]
  photos          String   @default("[]") // JSON string[] (url)
  isActive        Boolean  @default(true)
  capacityPerSlot Int      @default(1)
  hourlyPrice     Int      @default(300000) // 시간당 요금 (원)
  // 프로필 — 손님이 고를 때 실제로 보는 값들.
  // 흡연은 대화 거리가 가까워서, 문신은 싫어하는 손님이 있어서 미리 밝힌다.
  heightCm        Int?
  weightKg        Int?
  bustSize        String   @default("") // A~G 컵 표기. 빈 값이면 표시하지 않는다
  bustNatural     Boolean  @default(false)
  smoker          Boolean  @default(false)
  tattoo          Boolean  @default(false)
  tattooNote      String   @default("") // 위치·크기 (예: 손목 작게)
  adminMemo       String   @default("") // 관리자 전용 메모 (캐치걸에겐 안 보임)
  sortOrder       Int      @default(0)
  loginId         String?  @unique // 관리자가 발급한 계정
  passwordHash    String?
  createdAt       DateTime @default(now())

  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  schedules    StaffSchedule[]
  offs         StaffOff[]
  reservations Reservation[]
  reviews      Review[]
  comments     Comment[]
  favorites    Favorite[]
  votes        StaffVote[]
  assignments  ShiftAssignment[]
  timeOffs     StaffTimeOff[]
  options      StoreOption[] // 이 캐치걸이 제공하는 옵션 (본인이 켜고 끈다)

  @@index([storeId, isActive])
}

/**
 * 캐치걸이 스스로 알리는 "이 요일 이 조는 출근 가능해요".
 * 실제 근무가 아니라 희망 표시다 — 매장이 이걸 보고 ShiftAssignment 로 룸에 넣어야 확정된다.
 */
model StaffSchedule {
  id        String @id @default(cuid())
  staffId   String
  weekday   Int // 0(일)~6(토)
  shift     String @default("DAY") // DAY | NIGHT
  startTime String // 남겨두지만 조 시간대를 그대로 쓴다
  endTime   String
  staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
}

model StaffOff {
  id      String  @id @default(cuid())
  staffId String
  date    String // YYYY-MM-DD
  reason  String?
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
}

// ───────────────── 고객 ─────────────────
// 개인정보(휴대폰·실명·생일·이메일·SNS)는 수집하지 않는다.
// 신원은 매장 안에서만 통하는 닉네임 + PIN 이고, 사람에 대한 기억은 adminMemo / CustomerNote 에 남긴다.
//
// 카톡·전화로만 오가던 기존 손님은 앱에서 새 닉네임을 만들면 이력이 갈라진다.
// 그래서 관리자가 기존 고객에게 연결코드를 발급하고, 손님이 첫 로그인 때 그 코드를 넣으면
// 새 계정이 아니라 그 고객 기록을 이어받는다. 코드는 한 번 쓰면 사라진다.
model Customer {
  id            String   @id @default(cuid())
  storeId       String
  nickname      String
  passwordHash  String? // 고객이 정한 PIN. 관리자가 대신 만든 고객은 null → 첫 로그인 때 설정
  inviteCode    String? // 관리자가 발급한 연결코드 (사용 후 null). 중복은 발급할 때 확인한다
  // 매장이 직접 적어 두는 연락처 (전화·텔레그램 등). 손님이 입력하는 값이 아니고
  // 고객 화면에는 절대 나가지 않는다 — 매장 운영용 기록이다.
  adminContact  String   @default("")
  // 처음 어디를 통해 왔는지. 신규가 어느 사이트에서 오는지 알아야 광고비를 어디에 쓸지 정한다.
  sourceId      String?
  adminMemo     String   @default("") // 상단 고정 메모 (한눈에 보는 핵심)
  isBlacklisted Boolean  @default(false)
  createdAt     DateTime @default(now())

  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  reviews      Review[]
  comments     Comment[]
  favorites    Favorite[]
  notes        CustomerNote[]
  votes        StaffVote[]
  coupons      Coupon[]
  source       ReferralSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([storeId, nickname])
  @@index([storeId, inviteCode])
}

/**
 * 손님 한 명에게 준 쿠폰. 한 번 쓰면 끝난다.
 * 매장이 "이 분은 착하니까" 하고 그냥 줄 수 있어야 해서 사유를 같이 적어 둔다.
 */
model Coupon {
  id            String    @id @default(cuid())
  storeId       String
  customerId    String
  name          String // 손님에게 보일 이름 — "단골 감사 쿠폰"
  amount        Int // 정액 할인 (원)
  memo          String    @default("") // 매장만 보는 발급 사유
  expiresAt     DateTime?
  usedAt        DateTime?
  reservationId String?   @unique // 어느 예약에 썼는지
  createdAt     DateTime  @default(now())

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([storeId, customerId, usedAt])
}

/**
 * 등급 혜택. 단골·VIP 가 예약할 때마다 자동으로 붙는 할인.
 * grade 는 metrics 의 등급 이름을 그대로 쓴다 (단골 | VIP).
 */
model GradeBenefit {
  id      String  @id @default(cuid())
  storeId String
  grade   String
  amount  Int     @default(0)
  note    String  @default("") // 손님 화면에 보일 한 줄 설명
  isActive Boolean @default(true)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, grade])
}

/**
 * 기간 할인. 비 오는 날처럼 그날그날 매장이 정해 거는 할인이라
 * 하루짜리로도 만들 수 있게 시작일·종료일을 영업일 문자열로 둔다.
 */
model DayPromotion {
  id        String   @id @default(cuid())
  storeId   String
  name      String // "비 오는 날 할인"
  amount    Int
  startDate String // YYYY-MM-DD (영업일)
  endDate   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, startDate, endDate])
}

/** 관리자가 방문마다 남기는 날짜별 메모 (adminMemo 는 고정 요약, 이쪽은 시간순 기록) */
model CustomerNote {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  authorName String
  content    String
  createdAt  DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

// ───────────────── 예약 ─────────────────
// 예약 1건이 [startTime, endTime) 구간 전체를 차지한다 (연달아 예약 = 긴 구간 1건).
// 그래서 3시간을 이어서 예약해도 후기는 Review.reservationId UNIQUE 로 한 번만 달린다.
// 동시성: 같은 캐치걸의 겹치는 예약 수 < capacityPerSlot 인지 확인 후 INSERT.
// 확인과 INSERT 사이의 레이스는 트랜잭션 안에서 Staff 행을 FOR UPDATE 로 잠가 직렬화한다.
model Reservation {
  id           String    @id @default(cuid())
  code         String    @unique // 예약번호 (예: 2608-0231)
  storeId      String
  staffId      String
  customerId   String
  startTime    DateTime
  endTime      DateTime
  hours        Int       @default(1) // 이용 시간 (1시간 단위)
  partySize    Int       @default(1)
  requestNote  String    @default("")
  purposeTag   String    @default("")
  status       String    @default("CONFIRMED") // CONFIRMED | COMPLETED | CANCELLED | NOSHOW
  createdBy    String    @default("CUSTOMER") // CUSTOMER | ADMIN
  // 이 예약이 어디로 들어왔는지. 앱으로만 받는 게 아니라 전화·텔레그램·워크인이 섞인다.
  // 손님이 처음 매장을 알게 된 경로(Customer.sourceId)와는 다른 값이다.
  channel      String    @default("APP") // APP | PHONE | TELEGRAM | WALK_IN
  hourlyPrice  Int       @default(0) // 예약 시점 시급 스냅샷 — 이후 요금이 바뀌어도 과거 금액 보존
  optionsPrice Int       @default(0)
  // 할인은 매장이 부담한다. 캐치걸 몫은 정가 기준 그대로이고 매장 몫에서만 빠진다.
  discountAmount Int    @default(0)
  discountLabel  String @default("") // "VIP 혜택", "비 오는 날 할인" 처럼 손님에게 보일 이름
  totalPrice   Int       @default(0) // hourlyPrice * hours + optionsPrice - discountAmount (손님이 낸 금액)
  roomName     String? // 예약 시점의 배치 룸 이름 스냅샷 — 손님에게 "룸1" 이라고 안내한다
  createdAt    DateTime  @default(now())
  cancelledAt  DateTime?

  store    Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staff    Staff               @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  review   Review?
  options  ReservationOption[]
  coupon   Coupon?

  @@index([storeId, startTime])
  @@index([staffId, startTime])
  @@index([customerId, startTime])
}

/**
 * 근무 중 자리 비움 (외출·병원 등). 캐치걸 본인도, 관리자도 넣을 수 있다.
 * 이 시간대는 예약을 받지 않고, 관리자는 누가 언제 나갔는지 그대로 본다.
 */
model StaffTimeOff {
  id        String   @id @default(cuid())
  staffId   String
  date      String // 영업일 YYYY-MM-DD
  startTime String // HH:mm
  endTime   String // HH:mm
  reason    String   @default("")
  createdBy String   @default("STAFF") // STAFF | ADMIN
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
}

/** 접객 룸 (1번~10번 등). 한 룸에는 한 조당 캐치걸 한 명이 들어간다. */
model Room {
  id        String  @id @default(cuid())
  storeId   String
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]

  @@unique([storeId, name])
}

/**
 * 출근 배치 — 어느 영업일, 어느 조(주간/야간), 어느 룸에 누가 들어가는지.
 * 한 룸에 한 조당 한 명, 한 사람이 같은 조에 두 룸을 맡지 못하도록 DB 가 막는다.
 */
model ShiftAssignment {
  id        String   @id @default(cuid())
  storeId   String
  date      String // 영업일 YYYY-MM-DD
  shift     String // DAY | NIGHT — 조는 묶음 이름일 뿐, 실제 근무는 아래 시각이 정한다
  roomId    String
  staffId   String
  // 조 안에서도 몇 시부터 몇 시까지인지가 사람마다 다르다 (주간이지만 14:00 출근 등).
  // 예약 가능 시간과 룸 안내는 이 시각을 기준으로 한다.
  startTime String   @default("12:00")
  endTime   String   @default("20:00")
  // 예비로 걸어 둔 자리. 실제 근무가 아니므로 예약을 받지 않는다 —
  // 자리를 잡아 두되 손님에게는 열리지 않게 하는 표시다.
  isStandby Boolean  @default(false)
  // 그날 실제로 나왔는지. 배치를 아무리 미리 짜도 안 나오는 일이 잦아,
  // 누가 몇 번 펑크냈는지 남겨 두어야 다음 배치를 짤 수 있다.
  attendance String  @default("PLANNED") // PLANNED | PRESENT | LATE | NOSHOW | EXCUSED
  attendanceNote String @default("")
  checkedAt  DateTime?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([roomId, date, shift])
  @@unique([staffId, date, shift])
  @@index([storeId, date])
}

/** 고객 홈에 띄우는 공지 — 관리자에서 직접 쓰고 고칠 수 있다 */
model Notice {
  id        String   @id @default(cuid())
  storeId   String
  title     String
  body      String
  isPinned  Boolean  @default(false) // 목록 맨 위 고정
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, isActive])
}

/** 매장이 관리하는 추가 옵션 (이름·가격을 관리자에서 편집) */
model StoreOption {
  id        String  @id @default(cuid())
  storeId   String
  name      String
  price     Int
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservationOptions ReservationOption[]
  staff              Staff[] // 이 옵션을 제공하는 캐치걸들

  @@index([storeId, isActive])
}

/** 예약에 붙은 옵션 — 이름·가격은 예약 시점 값을 복사해 둔다 (옵션이 바뀌거나 삭제돼도 영수증은 그대로) */
model ReservationOption {
  id            String @id @default(cuid())
  reservationId String
  optionId      String?
  name          String
  price         Int

  reservation Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  option      StoreOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([reservationId])
}

// ───────────────── 후기 / 댓글 / 찜 ─────────────────
model Review {
  id            String    @id @default(cuid())
  storeId       String
  reservationId String    @unique
  staffId       String
  customerId    String
  rating        Int
  content       String
  photos        String    @default("[]") // JSON string[]
  isHidden      Boolean   @default(false)
  isReported    Boolean   @default(false)
  reportReason  String?
  reply         String?
  repliedAt     DateTime?
  createdAt     DateTime  @default(now())

  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  staff       Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([staffId, isHidden])
}

model Comment {
  id         String   @id @default(cuid())
  storeId    String
  staffId    String
  customerId String?
  authorType String   @default("CUSTOMER") // CUSTOMER | STAFF | ADMIN
  authorName String
  content    String
  parentId   String?
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staff    Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")

  @@index([staffId, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  staffId    String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([customerId, staffId])
}

/** 캐치걸 추천/비추천 — 고객 1명당 캐치걸 1명에게 한 표. 같은 버튼을 다시 누르면 취소된다. */
model StaffVote {
  id         String   @id @default(cuid())
  customerId String
  staffId    String
  value      String // UP | DOWN
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([customerId, staffId])
  @@index([staffId, value])
}
